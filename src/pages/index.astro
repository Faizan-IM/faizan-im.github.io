---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Metric from '../components/Metric.astro';
import CTA from '../components/CTA.astro';
import profile from '../assets/profile.jpg';
import { SITE, SOCIAL } from '../consts';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const stats = [
  { value: '7', label: 'projects' },
  { value: '22k+', label: 'lines · one mono-repo' },
  { value: '~140M', label: 'parcels targeted' },
  { value: '8+', label: 'statutes cited' },
];

const tracks = [
  {
    href: '/work',
    kicker: 'Build',
    title: 'Engineering',
    text: 'Production systems that turn messy real-world data into decisions — usually solo, under real constraints.',
  },
  {
    href: '/research',
    kicker: 'Research',
    title: 'Doctoral work',
    text: 'Bayesian optimization and agentic systems applied to functional genomics and T-cell regulatory networks.',
  },
  {
    href: '/tutoring',
    kicker: 'Teach',
    title: 'Tutoring',
    text: 'O & A Level Mathematics & Physics — taught for genuine understanding, not rote memorization.',
  },
];

const title = `${SITE.fullName} — Software Engineer, Researcher & Educator`;

// JSON-LD Person — ties the engineer + researcher + tutor identity together.
const sameAs = [SOCIAL.github, SOCIAL.linkedin, SOCIAL.x, SOCIAL.scholar].filter(
  (u): u is string => Boolean(u),
);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  url: SITE.domain,
  jobTitle: SITE.jobTitle,
  description: SITE.description,
  affiliation: { '@type': 'CollegeOrUniversity', name: SITE.affiliation },
  knowsAbout: SITE.knowsAbout,
  email: `mailto:${SITE.email}`,
  ...(sameAs.length ? { sameAs } : {}),
};
---

<Layout title={title}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personLd)}
  />

  <!-- HERO -->
  <section class="hero dot-grid" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="hero-kicker font-mono reveal reveal-1">{SITE.fullName}</p>
        <h1 id="hero-title" class="hero-title reveal reveal-2">
          I turn complexity into something <em>usable.</em>
        </h1>
        <p class="hero-lead reveal reveal-3">
          Solo software engineer and CS PhD scholar in Bahawalpur, Pakistan. I build
          production data systems, research AI for genomics, and teach O&nbsp;&amp;&nbsp;A
          Level Mathematics &amp; Physics.
        </p>
        <div class="hero-cta reveal reveal-4">
          <a href="/work" class="btn btn-primary">
            View the work
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/contact" class="btn btn-outline">Get in touch</a>
        </div>
      </div>

      <div class="hero-photo reveal reveal-3">
        <div class="photo-frame">
          <Image
            src={profile}
            alt={`Portrait of ${SITE.fullName}`}
            widths={[320, 460, 640]}
            sizes="(max-width: 820px) 60vw, 420px"
            loading="eager"
            class="photo-img"
          />
        </div>
        <span class="photo-accent" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- KEY STATS (mono / tabular motif) -->
  <section class="stats" aria-label="Key numbers">
    <div class="wrap stats-inner">
      {stats.map((s) => <Metric value={s.value} label={s.label} />)}
    </div>
  </section>

  <!-- THROUGH-LINE: three tracks -->
  <section class="section tracks" aria-labelledby="tracks-heading">
    <div class="wrap">
      <SectionHeading eyebrow="Three tracks, one instinct" title="Build · Research · Teach" level={2}>
        Builder, researcher, educator — one person who turns complexity into something
        usable, whether that's 140M property records, an AI research pipeline, or a hard
        physics concept for a 16-year-old.
      </SectionHeading>

      <div class="track-grid">
        {
          tracks.map((t) => (
            <a href={t.href} class="track-card">
              <span class="track-kicker font-mono">{t.kicker}</span>
              <h3 class="track-title">{t.title}</h3>
              <p class="track-text">{t.text}</p>
              <span class="track-arrow font-mono" aria-hidden="true">
                Explore →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section class="section featured-section" aria-labelledby="featured-heading">
    <div class="wrap">
      <SectionHeading eyebrow="Selected work" title="Featured projects" level={2}>
        A few systems that show the range — shipped, in delivery, and in active build.
        Every project repo is private; case studies tell the story.
      </SectionHeading>

      <div class="featured-grid">
        {featured[0] && <ProjectCard project={featured[0]} featured />}
        <div class="featured-pair">
          {featured.slice(1, 3).map((p) => <ProjectCard project={p} />)}
        </div>
      </div>

      <p class="see-all">
        <a href="/work" class="text-link font-mono">See all 7 projects →</a>
      </p>
    </div>
  </section>

  <!-- WHAT I DO / path to About -->
  <section class="section whatido" aria-labelledby="whatido-heading">
    <div class="wrap whatido-inner">
      <SectionHeading eyebrow="The through-line" title="One instinct, three tracks" level={2} />
      <p class="whatido-text">
        The common thread across engineering, research, and teaching is the same instinct:
        take complexity — 140M records, a research pipeline, or a hard physics idea — and
        make it usable. That's the story behind all of it.
      </p>
      <a href="/about" class="btn btn-outline">Read the full story</a>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  /* ─── Hero ─── */
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-kicker {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.1rem;
  }
  .hero-title {
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    line-height: 1.04;
    margin: 0 0 1.5rem;
    max-width: 16ch;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent);
  }
  .hero-lead {
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0 0 2rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-photo {
    position: relative;
    justify-self: start;
    width: min(72vw, 320px);
  }
  .photo-frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px color-mix(in oklab, var(--ink) 12%, transparent);
    background: color-mix(in oklab, var(--paper) 100%, var(--ink) 4%);
  }
  .photo-frame :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-accent {
    position: absolute;
    inset: auto -14px -14px auto;
    width: 110px;
    height: 110px;
    border: 2px solid color-mix(in oklab, var(--accent) 60%, transparent);
    border-radius: 16px;
    z-index: -1;
  }

  @media (min-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
    .hero-photo {
      width: 360px;
      justify-self: end;
    }
  }

  /* ─── Stats ─── */
  .stats {
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 100%, var(--ink) 2.5%);
  }
  .stats-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    padding-block: 2.75rem;
  }
  @media (min-width: 760px) {
    .stats-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ─── Tracks ─── */
  .track-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  @media (min-width: 760px) {
    .track-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .track-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .track-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--accent) 35%, var(--line));
    box-shadow: 0 16px 36px color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .track-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .track-title {
    font-size: 1.35rem;
    margin: 0;
  }
  .track-text {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .track-arrow {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--accent);
  }

  /* ─── Featured ─── */
  .featured-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .featured-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .featured-pair {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .see-all {
    margin-top: 2rem;
  }
  .text-link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ─── What I do ─── */
  .whatido-inner {
    max-width: 64ch;
  }
  .whatido-text {
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
</style>
