---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StackChip from '../../components/StackChip.astro';
import CTA from '../../components/CTA.astro';
import { SITE, SOCIAL } from '../../consts';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const title = `${data.title} — ${SITE.fullName}`;
---

<Layout title={title} description={data.summary} type="article">
  <article>
    <!-- Header -->
    <section class="cs-hero">
      <div class="wrap">
        <a href="/work" class="back-link font-mono">← All work</a>
        <div class="cs-badge">
          <StatusBadge category={data.category} label={data.status} />
        </div>
        <h1 class="cs-title">{data.title}</h1>
        <p class="cs-headline">{data.headline}</p>

        {
          data.metrics.length > 0 && (
            <ul class="metrics-strip" aria-label="Key numbers">
              {data.metrics.map((m) => (
                <li class="metric-pill font-mono">
                  <span class="metric-pill-dot" aria-hidden="true" />
                  {m}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <!-- Body + aside -->
    <section class="cs-body">
      <div class="wrap cs-grid">
        <div class="cs-main">
          <p class="cs-summary">{data.summary}</p>

          {
            data.pullQuote && (
              <blockquote class="cs-pull">
                <p>“{data.pullQuote}”</p>
              </blockquote>
            )
          }

          {
            data.highlights.length > 0 && (
              <div class="cs-highlights">
                <h2 class="cs-h2">Highlights</h2>
                <ul class="highlight-list">
                  {data.highlights.map((h) => (
                    <li>
                      <span class="hl-mark" aria-hidden="true" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <Prose class="cs-prose">
            <Content />
          </Prose>
        </div>

        <aside class="cs-aside">
          <div class="aside-block">
            <h2 class="aside-label font-mono">Role</h2>
            <p class="aside-text">{data.role}</p>
          </div>

          <div class="aside-block">
            <h2 class="aside-label font-mono">Stack</h2>
            <div class="aside-chips">
              {data.stack.map((s) => <StackChip label={s} />)}
            </div>
          </div>

          <div class="aside-block">
            <h2 class="aside-label font-mono">Links</h2>
            {
              data.links?.repo || data.links?.demo || data.links?.video ? (
                <ul class="aside-links">
                  {data.links?.repo && (
                    <li>
                      <a href={data.links.repo} target="_blank" rel="noopener noreferrer">
                        Repository ↗
                      </a>
                    </li>
                  )}
                  {data.links?.demo && (
                    <li>
                      <a href={data.links.demo} target="_blank" rel="noopener noreferrer">
                        Live demo ↗
                      </a>
                    </li>
                  )}
                  {data.links?.video && (
                    <li>
                      <a href={data.links.video} target="_blank" rel="noopener noreferrer">
                        Walkthrough video ↗
                      </a>
                    </li>
                  )}
                </ul>
              ) : (
                <p class="aside-private font-mono">Private — available on request</p>
              )
            }
            {
              SOCIAL.github && (
                <p class="aside-gh">
                  <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
                    GitHub profile ↗
                  </a>
                </p>
              )
            }
          </div>
        </aside>
      </div>
    </section>
  </article>

  <CTA
    title="Want the deeper walkthrough?"
    text="Happy to talk architecture, share a private demo, or scope something similar — just reach out."
  />
</Layout>

<style>
  .cs-hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }
  .back-link {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .cs-badge {
    margin-bottom: 1rem;
  }
  .cs-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 0 0 1rem;
    max-width: 18ch;
  }
  .cs-headline {
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }

  .metrics-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .metric-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .metric-pill-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .cs-body {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .cs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .cs-grid {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 4rem;
      align-items: start;
    }
  }

  .cs-summary {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--ink);
    margin: 0 0 2rem;
    max-width: 68ch;
  }
  .cs-pull {
    margin: 0 0 2.5rem;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 3px solid var(--accent);
  }
  .cs-pull p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--ink);
    margin: 0;
  }

  .cs-h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .cs-highlights {
    margin-bottom: 2.5rem;
  }
  .highlight-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .highlight-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .hl-mark {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-top: 0.55em;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .cs-prose {
    margin-top: 2.5rem;
  }

  /* Aside */
  .cs-aside {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  @media (min-width: 900px) {
    .cs-aside {
      position: sticky;
      top: 5.5rem;
      padding: 1.5rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: color-mix(in oklab, var(--paper) 100%, var(--ink) 2.5%);
    }
  }
  .aside-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .aside-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .aside-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .aside-private {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .aside-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .aside-links a,
  .aside-gh a {
    color: var(--accent);
    font-size: 0.9rem;
  }
  .aside-gh {
    margin: 0.75rem 0 0;
  }
</style>
