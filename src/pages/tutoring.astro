---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import { SITE, TUTORING } from '../consts';

const title = `O & A Level Maths & Physics Tutoring — ${SITE.fullName}`;
const description =
  'One-on-one O Level and A Level Mathematics and Physics tutoring focused on genuine understanding and exam confidence — not rote memorization.';

const subjects = [
  'O Level Mathematics',
  'A Level Mathematics',
  'O Level Physics',
  'A Level Physics',
];

const approach = [
  'Concept-first teaching that makes the “why” click before drilling the “how.”',
  'Structured past-paper practice and exam technique.',
  'Patient, step-by-step explanations pitched to each student’s level.',
  'Regular, honest feedback on progress.',
];

const details = [
  { label: 'Format', value: TUTORING.format },
  { label: 'Availability', value: TUTORING.availability },
  { label: 'Rates', value: TUTORING.rate },
];

// Booking link: use a configured contact method if set, else fall back to email.
const contactHref =
  TUTORING.contact ?? `mailto:${SITE.email}?subject=${encodeURIComponent('O/A Level tutoring enquiry')}`;
const waHref = `${SITE.whatsapp}?text=${encodeURIComponent("Hi, I'd like to ask about O/A Level tutoring.")}`;
---

<Layout title={title} description={description}>
  <section class="page-hero">
    <div class="wrap">
      <SectionHeading
        eyebrow="Tutoring"
        title="O & A Level Mathematics & Physics"
        level={1}
      />
      <p class="intro measure">
        I offer one-on-one tutoring in O Level and A Level Mathematics and Physics. My focus
        is on building genuine understanding and exam confidence — not rote memorization —
        so students can reason through unfamiliar problems, not just recall worked examples.
      </p>
      <div class="hero-actions">
        <a href={contactHref} class="btn btn-primary">Get in touch about tutoring</a>
        <a href={waHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          Message on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="t-section">
    <div class="wrap t-grid">
      <div class="t-block">
        <h2 class="t-h2">Subjects</h2>
        <ul class="subjects">
          {subjects.map((s) => <li class="subject">{s}</li>)}
        </ul>
      </div>

      <div class="t-block">
        <h2 class="t-h2">My approach</h2>
        <ul class="approach">
          {
            approach.map((a) => (
              <li>
                <span class="check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                </span>
                <span>{a}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="t-details-section">
    <div class="wrap">
      <div class="t-details">
        {
          details.map((d) => (
            <div class="detail">
              <span class="detail-label font-mono">{d.label}</span>
              <span class="detail-value">{d.value}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Ready to start?"
    text="Tell me your child’s board, subjects, and where they’re finding things tricky — I’ll reply personally with how I can help."
    primaryHref={contactHref}
    primaryLabel="Get in touch about tutoring"
    secondaryHref={waHref}
    secondaryLabel="Message on WhatsApp"
  />
</Layout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .intro {
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .t-section {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .t-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 760px) {
    .t-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
  }
  .t-h2 {
    font-size: 1.4rem;
    margin: 0 0 1.25rem;
  }

  .subjects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .subject {
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    font-weight: 500;
  }

  .approach {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .approach li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .check {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
    margin-top: 0.1rem;
  }

  .t-details-section {
    padding-block: clamp(1rem, 3vw, 2rem);
  }
  .t-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--line);
  }
  @media (min-width: 640px) {
    .t-details {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem;
    background: var(--paper);
  }
  .detail-label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .detail-value {
    font-size: 1.05rem;
    color: var(--ink);
  }
</style>
