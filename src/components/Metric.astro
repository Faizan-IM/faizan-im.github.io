---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="metric">
  <span class="metric-value font-mono">{value}</span>
  <span class="metric-label font-mono">{label}</span>
</div>

<style>
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .metric-value {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .metric-label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
