---
interface Props {
  eyebrow?: string;
  title: string;
  level?: 1 | 2;
  align?: 'left' | 'center';
}

const { eyebrow, title, level = 2, align = 'left' } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2';
const hasIntro = Astro.slots.has('default');
---

<div class:list={['section-heading', align]} data-level={level}>
  {
    eyebrow && (
      <p class="eyebrow font-mono">
        <span class="eyebrow-rule" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <Tag class="section-title">{title}</Tag>
  {
    hasIntro && (
      <div class="section-intro measure">
        <slot />
      </div>
    )
  }
</div>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .eyebrow-rule {
    width: 26px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  .section-title {
    margin: 0;
  }
  [data-level='1'] .section-title {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }
  [data-level='2'] .section-title {
    font-size: clamp(1.9rem, 3.5vw, 2.65rem);
  }

  .section-intro {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .center {
    text-align: center;
  }
  .center .eyebrow {
    justify-content: center;
  }
  .center .section-intro {
    margin-inline: auto;
  }
</style>
