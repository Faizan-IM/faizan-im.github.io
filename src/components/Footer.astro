---
import { SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();

// Only include socials that actually have a value (never link to '#').
const socials = [
  { key: 'github', href: SOCIAL.github, label: 'GitHub' },
  { key: 'linkedin', href: SOCIAL.linkedin, label: 'LinkedIn' },
  { key: 'x', href: SOCIAL.x, label: 'X (Twitter)' },
  { key: 'scholar', href: SOCIAL.scholar, label: 'Google Scholar' },
  { key: 'email', href: `mailto:${SITE.email}`, label: 'Email' },
].filter((s) => Boolean(s.href));
---

<footer class="site-footer">
  <hr class="rule-accent" aria-hidden="true" />
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{SITE.fullName}</p>
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer-social" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            class="social-link"
            aria-label={s.label}
            {...(s.key === 'email' ? {} : { target: '_blank', rel: 'me noopener noreferrer' })}
          >
            {s.key === 'github' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
              </svg>
            )}
            {s.key === 'linkedin' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
              </svg>
            )}
            {s.key === 'x' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
              </svg>
            )}
            {s.key === 'scholar' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />
              </svg>
            )}
            {s.key === 'email' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            )}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <p>© {year} {SITE.fullName}. All rights reserved.</p>
    <p>
      Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding-bottom: 2.5rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 2.5rem;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
  }
  .footer-tagline {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 40ch;
  }
  .footer-social {
    display: flex;
    gap: 0.4rem;
  }
  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.4rem;
    width: 2.4rem;
    border-radius: 8px;
    color: var(--ink-soft);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .social-link:hover {
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .footer-bottom p {
    margin: 0;
  }
  .footer-bottom a {
    color: var(--accent);
  }
</style>
